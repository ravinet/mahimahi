# mahimahi mm-link (Uplink) [../../traces/Verizon-LTE-short.up] > ./output/uplink_dualPI2.log
# command line: 'mm-link' '--meter-all' '--uplink-log=./output/uplink_dualPI2.log' '--downlink-log=./output/downlink_dualPI2.log' '--uplink-queue=dualPI2' '--uplink-queue-args=packets=100,interval=100,target=5' '../../traces/Verizon-LTE-short.up' '../../traces/Verizon-LTE-short.down' '--' 'bash' '-c' '
      echo '\''[+] Running L4S-marked flow (ToS=1, port 5300) on dualPI2...'\''
