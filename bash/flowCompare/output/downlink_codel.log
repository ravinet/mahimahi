# mahimahi mm-link (Downlink) [../../traces/Verizon-LTE-short.down] > ./output/downlink_codel.log
# command line: 'mm-link' '--meter-all' '--uplink-log=./output/uplink_codel.log' '--downlink-log=./output/downlink_codel.log' '--uplink-queue=codel' '--uplink-queue-args=packets=100,interval=100,target=5' '../../traces/Verizon-LTE-short.up' '../../traces/Verizon-LTE-short.down' '--' 'bash' '-c' '
      echo '\''[+] Running L4S-marked flow (ToS=1, port 5300) on codel...'\''
      iperf3 -c 10.0.0.1 -u -p 5300 -b 10M -t 10 --tos 1 > ./output/iperf_l4s_codel.log &

      echo '\''[+] Running Classic flow (default ToS, port 5301) on codel...'\''
      iperf3 -c 10.0.0.1 -u -p 5301 -b 10M -t 10 > ./output/iperf_classic_codel.log &

      sleep 1
      echo '\''[*] Active iperf3 processes in sandbox:'\''
      ps aux | grep iperf3 | grep -v grep

      wait
    '
